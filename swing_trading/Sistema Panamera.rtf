\f0\fs24 \cf0 //@version=6\
strategy('PANAMERA DONCHIAN', overlay = true)\
\
// Par\'e1metros de usuario\
donchianPeriod = input.int(11, 'Periodo del Canal de Donchian', minval = 5, maxval = 50)\
maPeriod = input.int(69, 'Periodo de la Media M\'f3vil', minval = 10, maxval = 300)\
atrPeriod = input.int(5, 'Periodo ATR', minval = 1, maxval = 50)\
volumeThreshold = input.float(1.4, 'Umbral de Volumen', minval = 1, maxval = 3, step = 0.1)\
exitMA = input.int(53, 'Periodo de MA para salida', minval = 10, maxval = 300)\
\
// C\'e1lculos del Canal de Donchian\
upperBand = ta.highest(high, donchianPeriod)\
lowerBand = ta.lowest(low, donchianPeriod)\
\
// C\'e1lculo de medias y ATR\
ma = ta.sma(close, maPeriod)\
exitMa = ta.sma(close, exitMA)\
atr = ta.atr(atrPeriod)\
\
// Filtro de tendencia basado en medias m\'f3viles\
trendFilter = close > ma\
\
// Filtro de volumen\
volumeFilter = volume > ta.sma(volume, 20) * volumeThreshold\
\
// L\'f3gica de entrada\
longCondition = close > upperBand[1] and trendFilter and volumeFilter\
\
// Plotting para visualizaci\'f3n\
plot(upperBand, color = color.blue, title = 'Upper Donchian')\
plot(lowerBand, color = color.blue, title = 'Lower Donchian')\
plot(ma, color = color.yellow, title = 'Trend MA')\
plot(exitMa, color = color.red, title = 'Exit MA')\
\
// Entrada en largo\
if longCondition\
    strategy.entry('Long', strategy.long)\
\
// L\'f3gica de salida sin stops ni profits\
exitCondition = close < exitMa or not trendFilter\
\
if strategy.position_size > 0 and exitCondition\
    strategy.close('Long')}
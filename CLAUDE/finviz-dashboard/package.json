{
  "name": "finviz-dashboard",
  "version": "1.0.0",
  "description": "Finviz live snapshot dashboard for macOS",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev":          "vite",
    "build":        "vite build",
    "electron-dev": "concurrently \"vite\" \"wait-on http://localhost:5174 && NODE_ENV=development electron .\"",
    "dist":         "vite build && electron-builder --mac"
  },
  "dependencies": {
    "react":     "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently":         "^8.2.0",
    "electron":             "^28.0.0",
    "electron-builder":     "^24.9.1",
    "vite":                 "^5.0.0",
    "wait-on":              "^7.2.0"
  },
  "build": {
    "appId":       "com.finviz.dashboard",
    "productName": "Finviz Dashboard",
    "mac": {
      "category": "public.app-category.finance",
      "target":   "dmg"
    },
    "extraResources": [
      { "from": "python/", "to": "python", "filter": ["**/*"] }
    ],
    "files": [
      "dist-react/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ]
  }
}

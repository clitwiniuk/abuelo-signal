graph TD
    %% Styling
    classDef external fill:#f9f,stroke:#333,stroke-width:2px;
    classDef core fill:#abd,stroke:#333,stroke-width:2px;
    classDef logic fill:#ffe,stroke:#333,stroke-width:2px;
    classDef output fill:#bfb,stroke:#333,stroke-width:2px;

    %% External Systems
    subgraph ExternalSources [External Data Sources]
        IBKR[IBKR API]:::external
        NewsAPIs["News Sources<br/>(Ben, Polygon, Finnhub)"]:::external
    end

    %% Data Acquisition Layer
    subgraph DataLayer [Data Acquisition Modules]
        Native["<b>IBKRNativeScanner</b><br/>Role: Data Fetcher"]:::core
        Batch["<b>BatchPriceManager</b><br/>Role: Real-time Updates"]:::core
    end

    %% Logic & Orchestration
    subgraph Brain [Logic & Analysis Core]
        Scanner["<b>SmallcapDailyScanner</b><br/>Role: The Orchestrator"]:::logic
        
        subgraph Validations
            EarlyBird["<b>EarlyBirdQualifier</b><br/>Role: Pre-market Checks"]:::logic
            Catalyst["<b>CatalystAnalyzer</b><br/>Role: News Sentiment"]:::logic
            Implicit["<b>ImplicitEventDetector</b><br/>Role: Price Anomalies"]:::logic
        end
        
        Tracker["<b>OpportunityTracker</b><br/>Role: Memory & State"]:::logic
    end

    %% Flow Connections
    IBKR -->|Raw Market Scans| Native
    IBKR -->|Price & Volume| Batch
    NewsAPIs -->|Headlines| Catalyst

    Native -->|Cleaned Candidate List| Scanner
    Batch -.->|Live Price Feeds| Scanner
    
    Scanner -->|1. Check Pre-market| EarlyBird
    Scanner -->|2. Analyze News| Catalyst
    Scanner -->|3. Check Implicit| Implicit
    
    Scanner -->|4. Validate & De-dupe| Tracker
    Tracker -- "If New or Upgrade" --> Scanner

    %% Output
    subgraph Downstream [Trading System]
        Trader["<b>Trading Engine</b><br/>Receives SmallcapPlay"]:::output
        Redis["<b>Redis Bus</b>"]:::output
    end
    
    Scanner ==>|Generates Opportunity| Trader
    Scanner ==>|Publishes Signal| Redis

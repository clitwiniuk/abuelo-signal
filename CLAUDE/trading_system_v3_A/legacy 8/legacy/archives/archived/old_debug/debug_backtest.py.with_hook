#!/usr/bin/env python3
"""
Debug backtest con DEEP HOOK para interceptar señales - VERSION FUNCIONAL
"""

import asyncio
import logging
import sys
from datetime import datetime, timedelta
from pathlib import Path
import pandas as pd
import numpy as np

# Add project root to path
sys.path.append(str(Path(__file__).parent))

from backtesting import (
    BacktestEngine, BacktestConfig, BacktestDataLoader
)
from strategies.optimized_gap_go_strategy import OptimizedGapGoStrategy
from backtests.backtest_config import (
    BacktestConfigurations,
    StrategyConfigurations
)
from core.interfaces import Signal, MarketData

def setup_logging():
    """Configurar logging"""
    logging.basicConfig(
        level=logging.INFO,
        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
        handlers=[
            logging.StreamHandler(),
            logging.FileHandler('debug_backtest.log')
        ]
    )

class SimpleMonitor:
    def __init__(self):
        self.signals_intercepted = 0
        self.entries_detected = 0
        self.exits_detected = 0
        
    def record_signal(self, signal_type, symbol, price):
        self.signals_intercepted += 1
        if 'EXIT' in signal_type:
            self.exits_detected += 1
            print(f"🔴 EXIT INTERCEPTED: {symbol} @ ${price:.2f}")
        else:
            self.entries_detected += 1
            print(f"🟢 ENTRY INTERCEPTED: {symbol} @ ${price:.2f}")

def load_symbol_data_directly(symbol: str, data_path: str = "data") -> pd.DataFrame:
    """Cargar datos directamente"""
    files = list(Path(data_path).glob(f"{symbol}*.csv"))
    if not files:
        return pd.DataFrame()
    
    try:
        df = pd.read_csv(files[0])
        df.columns = df.columns.str.lower()
        
        if 'timestamp' in df.columns:
            df['timestamp'] = pd.to_datetime(df['timestamp'])
            df.set_index('timestamp', inplace=True)
        elif not isinstance(df.index, pd.DatetimeIndex):
            df.index = pd.to_datetime(df.index)
        
        return df
    except Exception as e:
        print(f"❌ Error cargando {symbol}: {e}")
        return pd.DataFrame()

async def debug_backtest():
    """Debug con DEEP HOOK FUNCIONAL"""
    print("\n🚀 DEBUG BACKTEST CON DEEP HOOK")
    print("=" * 50)
    
    setup_logging()
    monitor = SimpleMonitor()
    
    # Configuración
    config = BacktestConfigurations.get_default_1min_config()
    config.start_date = datetime(2025, 4, 1)
    config.end_date = datetime(2025, 6, 1)
    
    # Parámetros de estrategia
        # PARÁMETROS CORREGIDOS - Usar los mismos que en la estrategia
    strategy_params = {
        # Gap Detection - MODERADAMENTE ESTRICTO
        'gap_percent_threshold': 1.5,        # CORREGIDO: Era 0.8
        'min_gap_percent': 2.0,              # CORREGIDO: Mantener en 2.0%
        'max_gap_percent': 20.0,             
        'gap_confirmation_bars': 0,          
        
        # Volume Requirements - MODERADAMENTE EXIGENTE
        'volume_multiplier': 1.8,            
        'min_volume': 15000,                 
        'volume_confirmation_bars': 1,       
        'min_daily_volume': 100000,          
        
        # Entry Conditions - MODERADAMENTE SELECTIVO
        'breakout_buffer': 0.008,            
        'momentum_confirmation': True,       
        'min_conditions_met': 3,             
        
        # Risk Management - BALANCEADO Y CORREGIDO
        'stop_loss_pct': 0.03,               # CORREGIDO: Era 0.015 → Cambiar a 3%
        'take_profit_pct': 0.06,             # CORREGIDO: 6%
        'trailing_stop_pct': 0.018,          
        'trailing_activation': 0.025,        
        
        # Position Sizing - MODERADO
        'max_position_value': 400.0,         
        'min_position_value': 80.0,          
        'max_risk_per_trade': 0.02,          
        'min_quantity': 5,                   
        
        # Timing Controls - MÁS FLEXIBLE
        'market_open_hour': 9.5,             
        'no_entry_after': 12.0,              
        'max_hold_time': 90,                 
        'cooldown_period': 60,               
        
        # Trading Limits - MODERADAMENTE ESTRICTO
        'max_daily_trades': 3,               
        'max_concurrent_positions': 2,       
        'daily_loss_limit': 150.0,           
        
        # Quality Filters - MODERADO
        'min_price': 1.5,                   
        'max_price': 75.0,                  
        
        # Commission & Costs
        'commission_per_share': 0.005,       
        'min_commission': 1.0,               
        'slippage_bps': 5,                   
        
        # Scanner Integration - BALANCEADO
        'trust_scanner_gap': True,
        'scanner_gap_timeout': 75,           
        'auto_detect_gaps': True,            
    }
    
    print(f"📊 CONFIGURACIÓN:")
    print(f"   Período: {config.start_date} a {config.end_date}")
    print(f"   Stop loss: {strategy_params.get('stop_loss_pct', 'N/A')}")
    print(f"   Gap threshold: {strategy_params.get('gap_percent_threshold', 'N/A')}")
    
    # Función de carga de datos
    def debug_data_loader(symbol, start_date, end_date):
        df = load_symbol_data_directly(symbol, "data")
        if df.empty:
            return df
        
        # Filtrar por fechas
        try:
            mask = (df.index >= start_date) & (df.index <= end_date)
            filtered_df = df[mask]
            if filtered_df.empty:
                filtered_df = df.tail(1000)
            return filtered_df
        except:
            return df.tail(1000)
    
    # Crear engine
    engine = BacktestEngine(config)
    
    # DEEP HOOK: Interceptar add_strategy del engine
    original_add_strategy = engine.add_strategy
    
    def hooked_add_strategy(strategy):
        """Hook que intercepta la adición de estrategia"""
        print(f"🔌 APLICANDO DEEP HOOK a {type(strategy).__name__}")
        
        # Interceptar on_bar
        original_on_bar = strategy.on_bar
        
        async def intercepted_on_bar(bar):
            """Interceptor de señales"""
            try:
                signal = await original_on_bar(bar)
                
                if signal:
                    signal_type = signal.signal_type.value if hasattr(signal.signal_type, 'value') else str(signal.signal_type)
                    monitor.record_signal(signal_type, bar.symbol, signal.price)
                
                return signal
            except Exception as e:
                print(f"❌ Error en interceptor: {e}")
                return await original_on_bar(bar)
        
        # Aplicar hook
        strategy.on_bar = intercepted_on_bar
        print(f"✅ HOOK APLICADO - Señales serán interceptadas")
        
        return original_add_strategy(strategy)
    
    # Aplicar deep hook al engine
    engine.add_strategy = hooked_add_strategy
    
    # Crear estrategia
    strategy = OptimizedGapGoStrategy(strategy_params)
    engine.add_strategy(strategy)
    engine.set_data_loader(debug_data_loader)
    
    # Buscar símbolos
    data_path = Path("data")
    csv_files = list(data_path.glob("*.csv"))
    symbols = []
    for file in csv_files:
        symbol = file.stem.split('_')[0].upper()
        if len(symbol) >= 2 and symbol.isalpha():
            symbols.append(symbol)
    
    available_symbols = sorted(list(set(symbols)))[:5]  # Solo 5 para debug
    print(f"\n🎯 PROCESANDO {len(available_symbols)} SÍMBOLOS: {available_symbols}")
    
    # Ejecutar backtest
    all_results = None
    for i, symbol in enumerate(available_symbols, 1):
        print(f"\n📊 {i}/{len(available_symbols)}: {symbol}")
        
        try:
            pre_signals = monitor.signals_intercepted
            
            results = await engine.run_backtest([symbol])
            
            post_signals = monitor.signals_intercepted
            signals_this_symbol = post_signals - pre_signals
            
            if results:
                print(f"   Engine trades: {getattr(results, 'total_trades', 0)}")
                print(f"   Señales interceptadas: {signals_this_symbol}")
                
                if signals_this_symbol > 0:
                    print(f"   ✅ INTERCEPTACIÓN EXITOSA")
                elif getattr(results, 'total_trades', 0) > 0:
                    print(f"   ❌ TRADES SIN SEÑALES INTERCEPTADAS")
                else:
                    print(f"   ℹ️  No hay actividad")
                
                if all_results is None:
                    all_results = results
                elif hasattr(results, 'trades') and results.trades:
                    all_results.trades.extend(results.trades)
                    all_results.total_trades += len(results.trades)
        
        except Exception as e:
            print(f"   ❌ Error: {e}")
    
    # Resumen final
    print(f"\n" + "=" * 60)
    print(f"📊 RESUMEN FINAL:")
    print(f"   Señales interceptadas total: {monitor.signals_intercepted}")
    print(f"   Entries: {monitor.entries_detected}")
    print(f"   Exits: {monitor.exits_detected}")
    
    if all_results:
        print(f"   Engine trades total: {getattr(all_results, 'total_trades', 0)}")
        print(f"   Win rate: {getattr(all_results, 'win_rate', 0):.1f}%")
        print(f"   Final capital: ${getattr(all_results, 'final_capital', 0):,.2f}")
        
        if monitor.signals_intercepted > 0:
            print(f"\n✅ DEEP HOOK FUNCIONANDO - Señales interceptadas exitosamente")
        else:
            print(f"\n❌ DEEP HOOK FALLÓ - No se interceptaron señales")
    else:
        print(f"\n⚠️  No se generaron resultados")
    
    return all_results

if __name__ == "__main__":
    try:
        asyncio.run(debug_backtest())
    except KeyboardInterrupt:
        print("\n👋 Interrumpido por usuario")
    except Exception as e:
        print(f"\n❌ Error: {e}")
        import traceback
        traceback.print_exc()

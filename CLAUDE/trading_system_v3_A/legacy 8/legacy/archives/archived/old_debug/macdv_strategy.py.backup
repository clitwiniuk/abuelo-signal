# strategies/macdv_strategy.py - ARCHIVO CORREGIDO COMPLETO
"""
MACD-V Strategy: Uses MACD with volume confirmation and additional filters.
"""

from typing import Optional, Dict, Any
import numpy as np
import pandas as pd

from .base import BaseStrategy
from core.interfaces import Signal, MarketData, SignalType, Position


class MACDVStrategy(BaseStrategy):
    """
    MACD-V Strategy implementation.
    
    Entry Conditions:
    1. MACD line crosses above signal line (bullish) or below (bearish)
    2. MACD histogram is increasing
    3. Volume is above average
    4. Price is above/below key moving averages
    5. Additional technical filters (RSI, ADX, Bollinger Bands)
    
    Exit Conditions:
    1. MACD reversal
    2. Stop loss/take profit
    3. Time-based exit
    4. Volume drying up
    """
    
    def __init__(self, parameters: Dict[str, Any] = None):
        default_params = {
            # MACD parameters - Ajustados para mayor selectividad
            'macd_fast': 8,         # Reducido de 12 para mayor sensibilidad
            'macd_slow': 21,        # Reducido de 26 para mayor sensibilidad
            'macd_signal': 5,       # Reducido de 9 para señales más rápidas
            'min_histogram_change': 0.00008,  # Aumentado para señales más fuertes
            
            # Volume parameters - Más estrictos
            'volume_period': 15,    # Reducido de 20 para mayor sensibilidad
            'volume_threshold': 1.5,  # Aumentado de 1.3 para señales más fuertes
            
            # Moving average parameters - Ajustados para tendencias más claras
            'ma_short': 8,          # Reducido de 10 para mayor sensibilidad
            'ma_long': 17,          # Reducido de 21 para adaptarse a tendencias más cortas
            'ma_trend_confirmation': True,  # Activado para mayor calidad de señales
            
            # RSI parameters - Más estrictos
            'rsi_period': 10,       # Reducido de 14 para mayor sensibilidad
            'rsi_oversold': 30,     # Reducido para señales más fuertes
            'rsi_overbought': 70,   # Aumentado para señales más fuertes
            'rsi_confirmation': True,  # Activado para mayor calidad de señales
            
            # ADX parameters - Más estrictos
            'adx_period': 10,       # Reducido de 14 para mayor sensibilidad
            'adx_threshold': 25,    # Aumentado para tendencias más fuertes
            'adx_confirmation': True,  # Activado para mayor calidad de señales
            
            # Bollinger Bands - Más estrictos
            'bb_period': 15,        # Reducido de 20 para mayor sensibilidad
            'bb_std': 2.0,          # Reducido para bandas más ajustadas
            'bb_confirmation': True,  # Activado para mayor calidad de señales
            
            # Risk management - Optimizado para cuentas pequeñas
            'stop_loss_pct': 0.05,  # Aumentado para dar más espacio a la operación
            'profit_target': 0.20,  # Objetivo único y ambicioso (reemplaza take_profit_pct)
            'trailing_stop_activation': 0.10,  # Activar trailing stop al 10% de beneficio
            'trailing_stop_distance': 0.05,    # 5% de distancia para el trailing stop
            
            # Minimum conditions to meet - Más estricto
            'min_conditions': 3,    # Aumentado para mayor calidad de señales
            
            # History
            'max_history_bars': 200,
            
            # Cooldown entre operaciones - Aumentado
            'min_seconds_between_trades': 300,  # Aumentado para reducir frecuencia de operaciones
            
            # Position sizing - Optimizado para cuentas pequeñas
            'max_position_value': 2000.0,  # Aumentado para operaciones más significativas
            'min_position_value': 500.0,   # Aumentado para evitar operaciones demasiado pequeñas
            'min_quantity': 100,           # Mínimo de acciones para evitar odd lots
            'risk_per_trade': 0.01,        # Reducido a 1% de riesgo por operación
            'commission_per_share': 0.01,   # Comisión por acción
            'min_commission': 1.0,         # Comisión mínima por operación
            
            # ATR para trailing stop y position sizing
            'atr_period': 14,
            'initial_stop_atr': 1.5,       # Stop loss inicial
            'stop_loss_atr': 2.0,          # Para cálculos de riesgo
            'take_profit_atr': 5.0,        # Para cálculos de beneficio
            'trailing_activation_atr': 1.0  # Activación del trailing stop
        }
        
        # Merge with provided parameters
        if parameters:
            default_params.update(parameters)
        
        super().__init__("MACDV", default_params)
        
        # Strategy state
        self.last_macd_values = {}
        self.entry_signals = {}
    
    async def _initialize_strategy(self) -> None:
        """Initialize MACD-V strategy"""
        self.logger.info("Initializing MACD-V strategy")
        self.logger.info(f"Parameters: {self.parameters}")
    
    async def _analyze_bar(self, bar: MarketData) -> Optional[Signal]:
        """Analyze bar, first manage open positions then look for entries"""
        # First, check if existing position needs exit
        exit_signal = self._check_exit_conditions(bar.symbol, bar)
        if exit_signal is not None:
            return exit_signal
        """Analyze bar and generate MACD-V signal similar to v1 implementation"""
        symbol = bar.symbol
        
        # Need sufficient history - al menos 50 barras o el máximo de los períodos de indicadores
        min_bars_needed = max(
            50,
            self._parameters['macd_slow'] + self._parameters['macd_signal'],
            self._parameters['volume_period'],
            self._parameters['ma_long']
        )
        
        if len(self.bars_history[symbol]) < min_bars_needed:
            self.logger.debug(f"[MACDV-LOG] {symbol}: Historial insuficiente: {len(self.bars_history[symbol])}/{min_bars_needed} barras")
            return None
        
        try:
            # Convertir el historial de barras a DataFrame para análisis
            df = self.get_bars_df(symbol, min_bars_needed + 10)  # Añadir margen
            
            if len(df) < min_bars_needed:
                self.logger.debug(f"[MACDV-LOG] {symbol}: DataFrame insuficiente: {len(df)}/{min_bars_needed} barras")
                return None
                
            # Calcular ATR (Average True Range)
            df['tr1'] = abs(df['high'] - df['low'])
            df['tr2'] = abs(df['high'] - df['close'].shift())
            df['tr3'] = abs(df['low'] - df['close'].shift())
            df['tr'] = df[['tr1', 'tr2', 'tr3']].max(axis=1)
            df['atr'] = df['tr'].rolling(self._parameters.get('atr_period', 14)).mean()
            
            # Calcular MACD-V: [(EMA(fast) - EMA(slow)) / ATR] × 100
            exp1 = df['close'].ewm(span=self._parameters['macd_fast'], adjust=False).mean()
            exp2 = df['close'].ewm(span=self._parameters['macd_slow'], adjust=False).mean()
            df['macd_raw'] = exp1 - exp2
            df['macdv'] = (df['macd_raw'] / df['atr']) * 100
            df['macdv_signal'] = df['macdv'].ewm(span=self._parameters['macd_signal'], adjust=False).mean()
            df['macdv_hist'] = df['macdv'] - df['macdv_signal']
            
            # Obtener los últimos valores
            current = df.iloc[-1]
            previous = df.iloc[-2]
            
            # Log de valores MACDV cada 10 barras para no saturar
            if len(self.bars_history[symbol]) % 10 == 0:
                self.logger.info(f"[MACDV-LOG] {symbol}: MACDV={current['macdv']:.2f}, Signal={current['macdv_signal']:.2f}, Hist={current['macdv_hist']:.2f}, ATR={current['atr']:.4f}")
            
            # Calcular si el MACDV estaba por debajo de -50 y ahora cruza por encima
            macdv_cross_above_minus50 = (previous['macdv'] <= -50 and current['macdv'] > -50)
            
            # Condición de entrada principal: MACDV cruza por encima de -50
            if macdv_cross_above_minus50:
                self.logger.info(f"[MACDV-SEÑAL] {symbol}: Señal LONG - MACD-V cruza por encima de -50: {previous['macdv']:.2f} -> {current['macdv']:.2f}")
                
                # Verificar condiciones adicionales (volumen y tendencia)
                volume_ok = self._check_volume_condition(symbol)
                trend_ok = self._check_ma_trend(symbol, "bullish")
                
                # Log detallado de condiciones
                self.logger.info(f"[MACDV-CONDICIONES] {symbol}: Volumen OK: {volume_ok}, Tendencia OK: {trend_ok}")
                
                # Necesitamos al menos volumen o tendencia favorable
                if volume_ok or trend_ok:
                    # Solo operamos en largo (LONG) - Ignoramos SHORT
                    signal_type = SignalType.LONG
                    strength = 0.8  # Alta confianza
                    
                    # Store entry signal info
                    self.entry_signals[symbol] = {
                        'type': "bullish",
                        'timestamp': bar.timestamp,
                        'price': bar.close,
                        'conditions': {
                            'macdv_cross': True,
                            'volume_ok': volume_ok,
                            'trend_ok': trend_ok
                        }
                    }
                    
                    # Añadir parámetros de trailing stop
                    self._parameters['initial_stop_atr'] = self._parameters.get('initial_stop_atr', 1.0)  # Stop loss inicial
                    self._parameters['stop_loss_atr'] = self._parameters.get('stop_loss_atr', 2.0)        # Trailing stop
                    self._parameters['take_profit_atr'] = self._parameters.get('take_profit_atr', 4.0)    # Take profit
                    self._parameters['trailing_activation_atr'] = self._parameters.get('trailing_activation_atr', 0.8)  # Activación trailing
                    
                    # Log detallado de la señal generada
                    self.logger.info(f"[MACDV-OPERACIÓN] {symbol}: GENERANDO SEÑAL LONG a ${bar.close:.2f} con fuerza {strength:.2f}")
                    self.logger.info(f"[MACDV-STOPS] {symbol}: ATR={current['atr']:.4f}, Stop inicial={self._parameters['initial_stop_atr']}xATR, Trailing={self._parameters['stop_loss_atr']}xATR, TP={self._parameters['take_profit_atr']}xATR")
                    
                    return Signal(
                        signal_id="",
                        symbol=symbol,
                        signal_type=signal_type,
                        strength=strength,
                        price=bar.close,
                        timestamp=bar.timestamp,
                        metadata={
                            'strategy': 'MACDV',
                            'crossover_type': "bullish",
                            'macdv_value': current['macdv'],
                            'atr': current['atr'],
                            'volume_ok': volume_ok,
                            'trend_ok': trend_ok
                        }
                    )
                else:
                    self.logger.info(f"[MACDV-RECHAZO] {symbol}: Señal RECHAZADA - No cumple condiciones mínimas (volumen o tendencia)")
            
            return None
            
        except Exception as e:
            self.logger.error(f"[MACDV-ERROR] {symbol}: Error analyzing bar: {e}")
            return None
    
    def _check_macd_crossover(self, symbol: str, current_macd: dict) -> Optional[str]:
        """Check for MACD crossover with additional filters"""
        try:
            # Get previous MACD values
            if symbol not in self.last_macd_values:
                self.last_macd_values[symbol] = current_macd
                return None
            
            prev_macd = self.last_macd_values[symbol]
            min_hist_change = self._parameters.get('min_histogram_change', 0.0001)
            
            # Check for bullish crossover (MACD crosses above signal)
            if (prev_macd['macd'] <= prev_macd['signal'] and 
                current_macd['macd'] > current_macd['signal']):
                
                # Additional checks for stronger confirmation
                hist_change = current_macd['histogram'] - prev_macd['histogram']
                if (hist_change > min_hist_change and  # Histogram increasing
                    current_macd['histogram'] < 0 and  # Below zero line (stronger reversal)
                    current_macd['macd'] < 0):         # MACD below zero
                    
                    self.last_macd_values[symbol] = current_macd
                    return "bullish"
            
            # Check for bearish crossover (MACD crosses below signal)
            elif (prev_macd['macd'] >= prev_macd['signal'] and 
                  current_macd['macd'] < current_macd['signal']):
                
                # Additional checks for stronger confirmation
                hist_change = prev_macd['histogram'] - current_macd['histogram']
                if (hist_change > min_hist_change and  # Histogram decreasing
                    current_macd['histogram'] > 0 and  # Above zero line (stronger reversal)
                    current_macd['macd'] > 0):         # MACD above zero
                    
                    self.last_macd_values[symbol] = current_macd
                    return "bearish"
            
            # Update stored values
            self.last_macd_values[symbol] = current_macd
            return None
            
        except Exception as e:
            self.logger.error(f"Error checking MACD crossover for {symbol}: {e}")
            return None
    
    def _evaluate_entry_conditions(self, symbol: str, bar: MarketData, macd_data: dict, signal_direction: str) -> dict:
        """Evaluate all entry conditions"""
        conditions = {}
        
        try:
            # 1. MACD Condition (already confirmed by crossover)
            conditions['macd_crossover'] = True
            
            # 2. Volume condition
            conditions['volume_confirmed'] = self._check_volume_condition(symbol)
            
            # 3. Moving average condition
            conditions['ma_trend'] = self._check_ma_trend(symbol, signal_direction)
            
            # 4. RSI condition (avoid overbought/oversold extremes)
            conditions['rsi_filter'] = self._check_rsi_condition(symbol, signal_direction)
            
            # 5. ADX condition (trend strength)
            conditions['adx_strength'] = self._check_adx_condition(symbol)
            
            # 6. Bollinger Bands condition
            conditions['bb_position'] = self._check_bollinger_condition(symbol, bar, signal_direction)
            
            # 7. Price momentum condition
            conditions['price_momentum'] = self._check_price_momentum(symbol, signal_direction)
            
            return conditions
            
        except Exception as e:
            self.logger.error(f"Error evaluating conditions for {symbol}: {e}")
            return {'error': False}
    
    def _check_volume_condition(self, symbol: str) -> bool:
        """Check if current volume is above average"""
        try:
            df = self.get_bars_df(symbol, self._parameters['volume_period'])
            if len(df) < self._parameters['volume_period']:
                return False
            
            current_volume = df['volume'].iloc[-1]
            avg_volume = df['volume'].iloc[:-1].mean()  # Exclude current bar
            
            return current_volume >= (avg_volume * self._parameters['volume_threshold'])
            
        except Exception as e:
            self.logger.error(f"Error checking volume condition for {symbol}: {e}")
            return False
    
    def _check_ma_trend(self, symbol: str, signal_direction: str) -> bool:
        """Check moving average trend alignment"""
        try:
            ma_short = self.calculate_sma(symbol, self._parameters['ma_short'])
            ma_long = self.calculate_sma(symbol, self._parameters['ma_long'])
            
            if ma_short is None or ma_long is None:
                return False
            
            current_price = self.bars_history[symbol][-1].close
            
            if signal_direction == "bullish":
                # For bullish signals: price > short MA > long MA
                return current_price > ma_short > ma_long
            else:
                # For bearish signals: price < short MA < long MA
                return current_price < ma_short < ma_long
                
        except Exception as e:
            self.logger.error(f"Error checking MA trend for {symbol}: {e}")
            return False
    
    def _check_rsi_condition(self, symbol: str, signal_direction: str) -> bool:
        """Check RSI is not in extreme territory"""
        try:
            rsi = self.calculate_rsi(symbol, self._parameters['rsi_period'])
            if rsi is None:
                return False
            
            if signal_direction == "bullish":
                # For bullish signals: RSI should not be overbought
                return rsi < self._parameters['rsi_overbought']
            else:
                # For bearish signals: RSI should not be oversold
                return rsi > self._parameters['rsi_oversold']
                
        except Exception as e:
            self.logger.error(f"Error checking RSI condition for {symbol}: {e}")
            return False
    
    def _check_adx_condition(self, symbol: str) -> bool:
        """Check ADX for trend strength"""
        try:
            adx = self.calculate_adx(symbol, self._parameters['adx_period'])
            if adx is None:
                return True  # If can't calculate, don't filter
            
            return adx >= self._parameters['adx_threshold']
            
        except Exception as e:
            self.logger.error(f"Error checking ADX condition for {symbol}: {e}")
            return True  # Don't filter if error
    
    def _check_bollinger_condition(self, symbol: str, bar: MarketData, signal_direction: str) -> bool:
        """Check Bollinger Bands position"""
        try:
            bb = self.calculate_bollinger_bands(symbol, self._parameters['bb_period'], self._parameters['bb_std'])
            if not bb:
                return True  # If can't calculate, don't filter
            
            current_price = bar.close
            
            if signal_direction == "bullish":
                # For bullish signals: price should not be too close to upper band
                return current_price < bb['upper'] * 0.98  # 2% buffer
            else:
                # For bearish signals: price should not be too close to lower band
                return current_price > bb['lower'] * 1.02  # 2% buffer
                
        except Exception as e:
            self.logger.error(f"Error checking Bollinger condition for {symbol}: {e}")
            return True
    
    def _check_exit_conditions(self, symbol: str, bar: MarketData) -> Optional[Signal]:
        """Determine whether existing position should be closed (stop-loss, trailing stop, profit target)"""
        if symbol not in self.entry_signals:
            return None
            
        info = self.entry_signals[symbol]
        side = info.get('type', 'bullish')  # bullish means long, bearish short
        entry_price = info.get('price')
        current_price = bar.close
        
        # Initialize tracking values if they don't exist
        if 'highest_price' not in info:
            info['highest_price'] = entry_price if side == 'bullish' else float('inf')
        if 'lowest_price' not in info:
            info['lowest_price'] = entry_price if side == 'bearish' else float('inf')
        
        # Update highest/lowest price seen
        if side == 'bullish':
            info['highest_price'] = max(info['highest_price'], current_price)
            current_pnl = (current_price - entry_price) / entry_price
        else:  # bearish
            info['lowest_price'] = min(info['lowest_price'], current_price)
            current_pnl = (entry_price - current_price) / entry_price
        
        # Check exit conditions
        exit_reason = None
        
        # 1. Initial Stop Loss
        stop_loss_pct = self._parameters.get('stop_loss_pct', 0.05)
        stop_price = entry_price * (1 - stop_loss_pct) if side == 'bullish' else entry_price * (1 + stop_loss_pct)
        
        if (side == 'bullish' and current_price <= stop_price) or \
           (side == 'bearish' and current_price >= stop_price):
            exit_reason = 'initial_stop_loss'
        
        # 2. Trailing Stop (only if we've reached activation threshold)
        if not exit_reason and current_pnl >= self._parameters.get('trailing_stop_activation', 0.10):
            trailing_distance = self._parameters.get('trailing_stop_distance', 0.05)
            
            if side == 'bullish':
                trailing_stop = info['highest_price'] * (1 - trailing_distance)
                if current_price <= trailing_stop:
                    exit_reason = 'trailing_stop'
            else:  # bearish
                trailing_stop = info['lowest_price'] * (1 + trailing_distance)
                if current_price >= trailing_stop:
                    exit_reason = 'trailing_stop'
        
        # 3. Profit Target
        if not exit_reason:
            profit_target = self._parameters.get('profit_target', 0.20)
            target_price = entry_price * (1 + profit_target) if side == 'bullish' else entry_price * (1 - profit_target)
            
            if (side == 'bullish' and current_price >= target_price) or \
               (side == 'bearish' and current_price <= target_price):
                exit_reason = 'profit_target'
        
        # Generate exit signal if any condition is met
        if exit_reason:
            self.logger.info(f"[MACDV-EXIT] {symbol}: {exit_reason} at {current_price:.2f} "
                           f"(Entry: {entry_price:.2f}, PnL: {current_pnl*100:.1f}%)")
            
            # Remove from entry_signals so we don't exit twice
            self.entry_signals.pop(symbol, None)
            
            # Create and return exit signal
            # Solo manejamos salidas de posiciones largas
            sig_type = SignalType.EXIT_LONG
            return Signal(
                signal_id="",
                symbol=symbol,
                signal_type=sig_type,
                strength=1.0,
                price=current_price,
                timestamp=bar.timestamp,
                metadata={
                    'reason': exit_reason,
                    'strategy': 'MACDV',
                    'entry_price': entry_price,
                    'pnl': current_pnl
                }
            )
            
        return None

    def _check_price_momentum(self, symbol: str, signal_direction: str) -> bool:
        """Check recent price momentum aligns with signal"""
        try:
            df = self.get_bars_df(symbol, 5)  # Last 5 bars
            if len(df) < 5:
                return True
            
            # Calculate price change over last few bars
            price_change = (df['close'].iloc[-1] - df['close'].iloc[-3]) / df['close'].iloc[-3]
            
            if signal_direction == "bullish":
                return price_change > -0.01  # Not falling too much
            else:
                return price_change < 0.01   # Not rising too much
                
        except Exception as e:
            self.logger.error(f"Error checking price momentum for {symbol}: {e}")
            return True
    
    def calculate_adx(self, symbol: str, period: int) -> Optional[float]:
        """Calculate ADX (Average Directional Index)"""
        try:
            df = self.get_bars_df(symbol, period * 2)
            if len(df) < period + 1:
                return None
            
            # Calculate True Range (TR)
            high_low = df['high'] - df['low']
            high_close = (df['high'] - df['close'].shift()).abs()
            low_close = (df['low'] - df['close'].shift()).abs()
            
            tr = pd.concat([high_low, high_close, low_close], axis=1).max(axis=1)
            
            # Calculate Directional Movement
            plus_dm = df['high'].diff()
            minus_dm = -df['low'].diff()
            
            plus_dm[plus_dm < 0] = 0
            minus_dm[minus_dm < 0] = 0
            
            # Smooth the values
            tr_smooth = tr.rolling(window=period).mean()
            plus_dm_smooth = plus_dm.rolling(window=period).mean()
            minus_dm_smooth = minus_dm.rolling(window=period).mean()
            
            # Calculate Directional Indicators
            plus_di = 100 * (plus_dm_smooth / tr_smooth)
            minus_di = 100 * (minus_dm_smooth / tr_smooth)
            
            # Calculate ADX
            dx = 100 * (plus_di - minus_di).abs() / (plus_di + minus_di)
            adx = dx.rolling(window=period).mean()
            
            return adx.iloc[-1]
            
        except Exception as e:
            self.logger.error(f"Error calculating ADX for {symbol}: {e}")
            return None
    
    def _check_strategy_exit(self, position: Position, current_bar: MarketData) -> Optional[str]:
        """MACD-V specific exit conditions with ATR-based trailing stop"""
        try:
            symbol = position.symbol
            
            # Check if we have entry signal info
            if symbol not in self.entry_signals:
                return None
            
            entry_info = self.entry_signals[symbol]
            entry_price = entry_info['price']
            is_long = entry_info['type'] == 'bullish'
            
            # Inicializar atributos de seguimiento si no existen
            if not hasattr(self, f'_{symbol}_high_water_mark'):
                setattr(self, f'_{symbol}_high_water_mark', current_bar.close)
                
            if not hasattr(self, f'_{symbol}_initial_stop'):
                # Calcular ATR
                atr = self.calculate_atr(symbol, 14)
                if not atr:
                    return None
                    
                # Establecer stop loss inicial (más ajustado)
                initial_stop_atr = self._parameters.get('initial_stop_atr', 1.5)
                initial_stop = entry_price - (atr * initial_stop_atr) if is_long else entry_price + (atr * initial_stop_atr)
                setattr(self, f'_{symbol}_initial_stop', initial_stop)
                self.logger.info(f"{symbol}: Stop loss inicial establecido en {initial_stop:.4f} (Precio: {entry_price:.4f}, ATR: {atr:.4f})")
            
            # Obtener el high water mark actual
            high_water_mark = getattr(self, f'_{symbol}_high_water_mark')
            
            # Actualizar high water mark
            if is_long and current_bar.close > high_water_mark:
                setattr(self, f'_{symbol}_high_water_mark', current_bar.close)
                high_water_mark = current_bar.close
            elif not is_long and current_bar.close < high_water_mark:
                setattr(self, f'_{symbol}_high_water_mark', current_bar.close)
                high_water_mark = current_bar.close
            
            # Calcular ATR para trailing stop
            atr = self.calculate_atr(symbol, 14)
            if not atr:
                return None
                
            # Parámetros de trailing stop
            stop_loss_atr = self._parameters.get('stop_loss_atr', 2.5)  # Trailing stop
            take_profit_atr = self._parameters.get('take_profit_atr', 5.0)  # Take profit
            trailing_activation_atr = self._parameters.get('trailing_activation_atr', 1.0)  # Activación trailing
            
            # Calcular la ganancia desde la entrada (en múltiplos de ATR)
            if is_long:
                gain_atr = (high_water_mark - entry_price) / atr if atr > 0 else 0
            else:
                gain_atr = (entry_price - high_water_mark) / atr if atr > 0 else 0
            
            # 1. Verificar si se alcanzó el take profit
            if gain_atr >= take_profit_atr:
                self.logger.info(f"{symbol}: Take profit alcanzado a {gain_atr:.2f} ATR")
                return "take_profit"
                
            # 2. Si la ganancia es suficiente, activar trailing stop
            if gain_atr >= trailing_activation_atr:
                # Calcular trailing stop dinámico
                trail_stop = high_water_mark - (atr * stop_loss_atr) if is_long else high_water_mark + (atr * stop_loss_atr)
                
                # Para posiciones largas, el stop solo sube. Para cortas, solo baja
                if is_long:
                    if not hasattr(self, f'_{symbol}_trailing_stop') or trail_stop > getattr(self, f'_{symbol}_trailing_stop', -float('inf')):
                        setattr(self, f'_{symbol}_trailing_stop', trail_stop)
                        self.logger.info(f"{symbol}: Trailing stop actualizado a {trail_stop:.4f} (Precio: {current_bar.close:.4f}, ATR: {atr:.4f})")
                else:
                    if not hasattr(self, f'_{symbol}_trailing_stop') or trail_stop < getattr(self, f'_{symbol}_trailing_stop', float('inf')):
                        setattr(self, f'_{symbol}_trailing_stop', trail_stop)
                        self.logger.info(f"{symbol}: Trailing stop actualizado a {trail_stop:.4f} (Precio: {current_bar.close:.4f}, ATR: {atr:.4f})")
                        
                # Verificar si el precio ha cruzado el trailing stop
                trailing_stop = getattr(self, f'_{symbol}_trailing_stop')
                if (is_long and current_bar.close < trailing_stop) or (not is_long and current_bar.close > trailing_stop):
                    self.logger.info(f"{symbol}: Precio {current_bar.close:.4f} cruza trailing stop {trailing_stop:.4f}")
                    return "trailing_stop"
            else:
                # 3. Si no hay suficiente ganancia, usar stop loss inicial
                initial_stop = getattr(self, f'_{symbol}_initial_stop')
                
                # Verificar si el precio ha cruzado el stop loss inicial
                if (is_long and current_bar.close < initial_stop) or (not is_long and current_bar.close > initial_stop):
                    self.logger.info(f"{symbol}: Precio {current_bar.close:.4f} cruza stop loss inicial {initial_stop:.4f}")
                    return "stop_loss"
            
            # 4. MACD reversal exit (como respaldo adicional)
            macd_data = self.calculate_macd(
                symbol,
                self._parameters['macd_fast'],
                self._parameters['macd_slow'],
                self._parameters['macd_signal']
            )
            
            if macd_data:
                # Check for MACD reversal
                if is_long:
                    # Exit long if MACD crosses below signal
                    if macd_data['macd'] < macd_data['signal'] and macd_data['histogram'] < 0:
                        return "macd_reversal"
                else:
                    # Exit short if MACD crosses above signal
                    if macd_data['macd'] > macd_data['signal'] and macd_data['histogram'] > 0:
                        return "macd_reversal"
            
            return None
            
        except Exception as e:
            self.logger.error(f"Error checking strategy exit for {symbol}: {e}")
            return None
    
    def calculate_position_size(self, signal: Signal, capital: float, risk_per_trade: float) -> int:
        """Calculate position size for MACD-V strategy with commission consideration"""
        try:
            symbol = signal.symbol
            price = signal.price
            
            # 1. Calculate base position size based on risk
            risk_amount = capital * min(risk_per_trade, self._parameters.get('risk_per_trade', 0.01))
            stop_loss_pct = self._parameters.get('stop_loss_pct', 0.05)
            stop_distance = price * stop_loss_pct
            
            # 2. Calculate minimum viable position size to cover commissions
            min_commission = self._parameters.get('min_commission', 1.0)
            commission_per_share = self._parameters.get('commission_per_share', 0.01)
            
            # Minimum position value to make trade viable after commissions
            min_position_value = max(
                self._parameters.get('min_position_value', 500.0),
                (min_commission * 2) / 0.01  # Ensure at least 1% profit covers commissions
            )
            
            # 3. Calculate base quantity
            if stop_distance > 0:
                base_quantity = int(risk_amount / stop_distance)
                
                # Calculate position value and adjust if below minimum
                position_value = base_quantity * price
                if position_value < min_position_value:
                    base_quantity = int(min_position_value / price) + 1
            else:
                base_quantity = int(min_position_value / price) + 1
            
            # 4. Apply position limits
            # Max shares based on max position value
            max_position_value = self._parameters.get('max_position_value', 2000.0)
            max_shares_value = int(max_position_value / price)
            
            # Max shares based on max risk per trade (5% of capital)
            max_shares_risk = int((capital * 0.05) / price)
            
            # Take the more restrictive limit
            max_shares = min(max_shares_value, max_shares_risk)
            
            # 5. Redondear hacia abajo al múltiplo de 100 más cercano para small caps
            if price < 10.0:  # Para acciones de bajo precio
                position_size = (int(min(base_quantity, max_shares)) // 100) * 100
                position_size = max(position_size, self._parameters.get('min_quantity', 100))
            else:  # Para acciones de mayor precio
                position_size = int(min(base_quantity, max_shares))
                position_size = max(position_size, self._parameters.get('min_quantity', 100))
            
            # 6. Calculate estimated commissions
            total_commission = (position_size * commission_per_share * 2) + (min_commission * 2)
            position_value = position_size * price
            commission_pct = (total_commission / position_value) * 100
            
            self.logger.info(
                f"MACDV position size for {symbol}: {position_size} shares @ {price:.2f} "
                f"(Value: ${position_value:,.2f}, Comm: ${total_commission:.2f} = {commission_pct:.2f}%)"
            )
            
            # 7. Log warning if commission is too high relative to position size
            if commission_pct > 1.0:  # More than 1% in commissions
                self.logger.warning(
                    f"High commission impact ({commission_pct:.2f}%) for {symbol}. "
                    f"Consider increasing position size or finding lower commission options."
                )
                
                # Si después de redondear queda en 0, verificar si podemos hacer 100 acciones
                if position_size < 100:
                    # Verificar si 100 acciones están dentro del límite
                    if 100 * price <= max_position_value * 1.01:
                        position_size = 100
                    else:
                        self.logger.warning(
                            f"{signal.symbol}: Cannot open position - 100 shares cost ${100 * price:.2f} "
                            f"(Limit: ${max_position_value:.2f})"
                        )
                        return 0
            
            exposure = position_size * price
            self.logger.info(f"Position size for {signal.symbol}: {position_size} shares (Price: ${price:.4f}, Exposure: ${exposure:.2f})")
            
            return position_size
            
        except Exception as e:
            self.logger.error(f"Error calculating position size for {signal.symbol}: {e}")
            return 100  # Mínimo por defecto
    
    def get_strategy_info(self) -> dict:
        """Get strategy-specific information"""
        return {
            "name": self.name,
            "type": "Momentum + Volume",
            "timeframe": "Intraday",
            "parameters": self.parameters,
            "active_signals": len(self.entry_signals),
            "performance": self.get_performance_stats()
        }
graph TD
    subgraph "Trader Process"
        IT[IndependentTrader] --> SL[ServiceLocator]
        IT --> STB[ScannerTraderBridge]
        IT --> WBSE[WorkerBasedStrategyEngine]
        IT --> EOD[EODOHLCDownloader]
        IT --> SNAP[ActiveTradesSnapshotScheduler]
        
        subgraph "Core Logic"
            WBSE --> CE[ContextEngine]
            WBSE --> TA[TradeArbiter]
            WBSE --> WORKERS[Strategy Workers]
            
            subgraph "Workers Cluster"
                W1[DailyPlaysWorker]
                W2[ORBWorker]
                W3[VWAPWorker]
                W4[LivermoreWorker]
                W5[...Other Workers...]
            end
            
            WORKERS --> W1
            WORKERS --> W2
            WORKERS --> W3
            WORKERS --> W4
            WORKERS --> W5
        end
        
        subgraph "Execution Layer"
            WORKERS --> EEA[ExecutionEngineAdapter]
            EEA --> RM[RiskManager]
            EEA --> IBKR[IBKRAdapter]
            EEA --> DB[DatabaseManager]
        end
        
        subgraph "External/Shared"
            Redis[Redis Pub/Sub] --> STB
            Telegram[TelegramClient]
            IBKR_API[IBKR TWS/Gateway]
        end
        
        IT --> Telegram
        EEA --> Telegram
        IBKR --> IBKR_API
    end
    
    classDef main fill:#f9f,stroke:#333,stroke-width:2px;
    classDef core fill:#bbf,stroke:#333,stroke-width:2px;
    classDef exec fill:#bfb,stroke:#333,stroke-width:2px;
    classDef ext fill:#ddd,stroke:#333,stroke-width:1px;
    
    class IT,WBSE,EEA main;
    class W1,W2,W3,W4,W5,CE,TA,WORKERS core;
    class RM,IBKR,DB exec;
    class Redis,Telegram,IBKR_API ext;

sequenceDiagram
    participant Scanner
    participant Redis
    participant Trader as IndependentTrader
    participant Engine as WorkerBasedStrategyEngine
    participant Context as ContextEngine
    participant Worker as StrategyWorker
    participant Adapter as ExecutionEngineAdapter
    participant Risk as RiskManager
    participant IBKR as IBKRAdapter

    Scanner->>Redis: Publish Opportunity
    Redis->>Trader: Receive message
    Trader->>Engine: process_opportunity(opp)
    
    activate Engine
    Engine->>Context: detect_context(ticker_data)
    Context-->>Engine: Context (e.g. BULLISH_TREND)
    
    Engine->>Engine: Filter Workers (Capability Check)
    
    par Parallel Execution
        Engine->>Worker: process_opportunity(opp)
    and
        Engine->>Worker: ...other workers...
    end
    
    activate Worker
    Worker->>Worker: Analyze Pattern (80% complete?)
    
    alt Pattern Valid
        Worker->>Adapter: enter_position(symbol, strategy, data)
        activate Adapter
        
        Adapter->>Adapter: Lock Symbol (Mutex)
        Adapter->>Adapter: Check Pending Competition
        
        Adapter->>IBKR: batch_price_manager.get_current_price()
        IBKR-->>Adapter: Fresh Price
        
        Adapter->>Risk: validate_order(order)
        Risk-->>Adapter: Approved
        
        Adapter->>IBKR: place_order(order)
        IBKR-->>Adapter: OrderID
        
        Adapter->>Adapter: Save Trade (PENDING)
        
        loop Wait for Execution
            Adapter->>IBKR: get_positions() (Poll)
        end
        
        Adapter-->>Worker: Position Details
        deactivate Adapter
        
        Worker-->>Engine: Success (Entered)
    else Pattern Invalid
        Worker-->>Engine: Rejected
    end
    deactivate Worker
    
    Engine->>Trader: Processing Complete
    deactivate Engine

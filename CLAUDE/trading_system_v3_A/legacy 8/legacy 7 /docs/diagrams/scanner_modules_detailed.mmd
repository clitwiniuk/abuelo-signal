graph TD
    %% Styling
    classDef external fill:#f9f,stroke:#333,stroke-width:2px;
    classDef core fill:#abd,stroke:#333,stroke-width:2px;
    classDef internal fill:#eef,stroke:#333,stroke-width:1px,stroke-dasharray: 5 5;
    classDef logic fill:#ffe,stroke:#333,stroke-width:2px;
    classDef output fill:#bfb,stroke:#333,stroke-width:2px;

    %% External Systems
    subgraph ExternalSources [External Data Sources]
        IBKR[Interactive Brokers API]:::external
        NewsAPIs["News Sources<br/>(Ben, Polygon, Finnhub)"]:::external
    end

    %% Data Acquisition Layer (IBKRNativeScanner)
    subgraph NativeScanner [IBKRNativeScanner]
        direction TB
        
        subgraph ActiveScanners [Active Scanner Profiles]
            S1[Volume Surge Movers]:::internal
            S2[Hot By Price]:::internal
            S3[Early Movers]:::internal
            S4[Steady Gainer]:::internal
            S5[Rel Vol Intraday]:::internal
            S6[Mid Cap Movers]:::internal
        end

        subgraph DataEnrichment [Data Enrichment Layer]
            E1[Fetch Current Price/Vol]:::internal
            E2[Fetch 1-min History Bars]:::internal
            E3[Calculate VWAP]:::internal
            E4[Fetch Market Cap]:::internal
        end

        Batch["<b>BatchPriceManager</b><br/>Role: Real-time Updates"]:::core
    end

    %% Logic & Orchestration (SmallcapDailyScanner)
    subgraph Brain [SmallcapDailyScanner]
        direction TB
        Orchestrator["<b>Orchestrator Logic</b>"]:::logic
        
        subgraph ValidationModules [Validation Modules]
            EarlyBird["<b>EarlyBirdQualifier</b><br/>(Pre-market Low Float)"]:::logic
            
            subgraph CatalystAnalyzer [CatalystAnalyzer]
                style CatalystAnalyzer fill:#fff,stroke:#333,stroke-width:1px
                FinBERT["<b>FinBERT AI</b><br/>(Sentiment Scores)"]:::internal
                Keywords["<b>Keyword Matcher</b><br/>(FDA, M&A, Earnings)"]:::internal
            end
            
            Implicit["<b>ImplicitEventDetector</b><br/>(Price/Vol Anomalies)"]:::logic
        end
        
        Tracker["<b>OpportunityTracker</b><br/>(Validates & De-dupes)"]:::logic
    end

    %% Flow Connections
    IBKR -->|Raw Market Scan| ActiveScanners
    
    %% Internal Flow in NativeScanner
    ActiveScanners -->|Raw Candidates| DataEnrichment
    DataEnrichment -->|Enhanced Results| Orchestrator
    
    %% External Data Flow
    IBKR -->|Historical Data| E2
    NewsAPIs ==>|Headlines| CatalystAnalyzer
    Batch -.->|Live Ticks| Orchestrator

    %% Logic Flow
    Orchestrator -->|1. Filter| EarlyBird
    Orchestrator -->|2. Analyze| CatalystAnalyzer
    
    %% Inner Catalyst Flow
    NewsAPIs -.-> FinBERT
    NewsAPIs -.-> Keywords
    
    Orchestrator -->|3. Validate| Implicit
    
    Orchestrator -->|4. Final Check| Tracker
    Tracker -- "Quality > Threshold" --> Orchestrator

    %% Output
    subgraph Downstream [Trading System]
        Trader["<b>Trading Engine</b><br/>(Receives SmallcapPlay)"]:::output
        Redis["<b>Redis Bus</b><br/>(Publishes Signals)"]:::output
    end
    
    Orchestrator ==>|Execute| Trader
    Orchestrator ==>|Notify| Redis
